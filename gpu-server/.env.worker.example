# GPU Worker Environment Variables
# Copy this file to .env.worker and fill in your values

# Backend API Configuration
BACKEND_URL=https://sanjeevanjewellery-backend-381211478432.us-central1.run.app

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=jewelai-production

# Worker Configuration
POLL_INTERVAL=5
IDLE_SHUTDOWN_MINUTES=5
