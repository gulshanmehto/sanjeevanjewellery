# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
DB_NAME=jewelai

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-pro-image-preview

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:31000,https://yourdomain.vercel.app

# Admin Configuration (optional)
# ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here
# JWT_SECRET_KEY=your_secret_key_for_jwt_tokens

# Server Configuration
PORT=32000
HOST=0.0.0.0
